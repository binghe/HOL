INCLUDES = ../integer ../res_quan/src ../sort

all: $(DEFAULT_TARGETS) selftest.exe
.PHONY: all

selftest.exe : selftest.uo ratLib.uo ratTheory.uo ratReduce.uo
	$(HOLMOSMLC) -o $@ $<

intExtensionTheory.sml: ../integer/int_arithTheory.uo

EXTRA_CLEANS = selftest.exe rational-selftest.log

ifeq ($(KERNELID),otknl)
ARTFILES = $(patsubst %Script.sml,%.ot.art,$(wildcard *Script.sml))

all: $(ARTFILES) hol4-rational.art

hol4-rational-unint.art: hol4-rational-unint.thy $(ARTFILES)
	opentheory info --article -o $@ $<

hol4-rational.art: hol4-rational.thy hol4-rational-unint.art ../opentheory/hol4.int
	opentheory info --article -o $@ $<

install: hol4-rational.thy hol4-rational.art
	opentheory install --reinstall $<
endif

ifdef HOLSELFTESTLEVEL
all: rational-selftest.log

rational-selftest.log: selftest.exe
	$(tee ./selftest.exe 2>&1, $@)

endif

ifdef HOLBUILD
all: link-to-sigobj
.PHONY: link-to-sigobj
link-to-sigobj: $(DEFAULT_TARGETS)
	$(HOL_LNSIGOBJ)
endif
